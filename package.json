{
  "name": "@dsg/sysmlv2-view-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=26.3.1 <27"
  },
  "scripts": {
    "dev": "npm run engines:prepare && vite dev",
    "build": "npm run engines:prepare && tsc --noEmit && vite build",
    "preview": "vite preview",
    "engines:prepare": "node scripts/prepare-sysml-toolkit.mjs && node scripts/prepare-opensysml.mjs",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "format": "prettier --write .",
    "lint": "prettier --check . && npm run check:architecture",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "examples:index": "node scripts/examples-index.mjs",
    "test:examples": "node --test scripts/examples.test.mjs && playwright test --project=functional examples.spec.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "elkjs": "^0.11.1",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "4.14.8",
    "tw-animate-css": "1.4.0",
    "typebox": "1.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.0",
    "vite": "~8.2.4",
    "vitest": "^4.1.12"
  }
}
