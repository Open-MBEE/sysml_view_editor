{
  "version": 1,
  "examples": [
    {
      "id": "comments",
      "title": "Comments and documentation",
      "topics": [
        "comments",
        "documentation",
        "annotations",
        "unicode",
        "long-labels"
      ],
      "files": ["model.sysml", "views.sysml"],
      "views": [
        {
          "id": "DocumentationViews::overview",
          "engineKind": "tree",
          "app": "partial",
          "nodeNames": [
            "CommentExample::Pump",
            "CommentExample::ServiceLoop",
            "pump"
          ],
          "edgeKinds": ["composition"],
          "targets": [
            "Keep line and block comments intact in source.",
            "Show documentation and semantic comment callouts anchored to the correct element.",
            "Preserve Unicode punctuation and text through download/reopen.",
            "Fit qualified names inside their symbols at a readable scale."
          ],
          "gaps": [
            "Documentation and semantic comment callouts are not drawn or transported as note bodies/anchors by the current bridge.",
            "Long qualified labels can extend past the fixed-width tree nodes."
          ],
          "notices": []
        },
        {
          "id": "DocumentationViews::maintenance",
          "engineKind": "interconnection",
          "app": "partial",
          "nodeNames": ["CommentExample::ServiceLoop", "pump"],
          "edgeKinds": [],
          "targets": [
            "Keep the documented ServiceLoop and its pump visually distinct.",
            "Make maintenance notes readable without confusing them with model elements."
          ],
          "gaps": [
            "The structural diagram renders the parts; semantic documentation/comment callouts remain unavailable."
          ],
          "notices": []
        }
      ]
    },
    {
      "id": "packages",
      "title": "Packages and imports",
      "topics": ["packages", "imports", "ownership", "multiple-files"],
      "files": ["model.sysml", "views.sysml"],
      "views": [
        {
          "id": "OrganizationViews::outline",
          "engineKind": "tree",
          "app": "partial",
          "nodeNames": [
            "Organization::Common",
            "Sensor",
            "Organization::Control",
            "Controller",
            "feedback",
            "Organization::Plant",
            "Installation",
            "controller"
          ],
          "edgeKinds": ["composition", "composition"],
          "targets": [
            "Show nested package/type ownership without merging similarly named elements.",
            "Preserve resolution of Controller and Sensor across private imports."
          ],
          "gaps": [
            "The outline is a flat tree; package containers and import arrows require the package renderer."
          ],
          "notices": []
        },
        {
          "id": "OrganizationViews::dependencies",
          "engineKind": "package",
          "app": "unavailable",
          "nodeNames": [
            "Organization",
            "Organization::Common",
            "Organization::Control",
            "Organization::Plant"
          ],
          "edgeKinds": [
            "containment",
            "containment",
            "import",
            "containment",
            "import"
          ],
          "targets": [
            "Draw package containment separately from import dependencies.",
            "Keep Common, Control and Plant legible with directional import relationships."
          ],
          "gaps": [
            "The engine emits a package graph, but the application has no package-graph renderer."
          ],
          "notices": []
        }
      ]
    },
